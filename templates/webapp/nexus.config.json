{
  "appRoot": ".",
  "changelog": { "path": "CHANGELOG.md", "sourceDirs": ["src/"] },
  "docs": { "root": "docs", "archiveDir": "docs/存档", "designDir": "docs/设计", "index": "CLAUDE.md" },
  "deploy": {
    "target": "deploy@your-server",
    "remoteRoot": "/var/www/your-app",
    "publicUrl": "",
    "localPort": 8888,
    "keep": 5,
    "branch": "main"
  },
  "worktree": {
    "portBase": 4173,
    "share": [".build-number"],
    "postCreate": [["pnpm", "install", "--frozen-lockfile"]],
    "postMerge": [["pnpm", "build"]]
  },
  "release": {
    "steps": [
      ["pnpm", "check"],
      ["pnpm", "build"],
      ["pnpm", "run", "deploy"]
    ],
    "push": true,
    "githubRelease": false
  }
}
