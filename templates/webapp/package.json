{
  "name": "nexus-webapp-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-build.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "docs:check": "nexus-devflow docs-audit",
    "hooks": "nexus-devflow install-hooks",
    "check": "pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "nexus-devflow deploy"
  },
  "dependencies": {
    "@nexus-kit/pwa": "workspace:*",
    "@nexus-kit/pwa-react": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nexus-kit/devflow": "workspace:*",
    "@nexus-kit/vite": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^18.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0",
    "workbox-window": "^7.4.1"
  }
}
