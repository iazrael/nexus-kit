# 依赖
node_modules/

# 构建产物（packages/*/dist 入库：git 依赖直接消费，见 docs/规范/工程质量与交付规范.md）
templates/*/dist/
*.tsbuildinfo

# 缓存与临时（.e2e/ 是真浏览器 e2e 的模板副本与站点，可再生）
.e2e/
.cache/
coverage/
temp/
.build-number
.build-number.lock

# 评审/图示产物的可再生成浏览器证据（visual-check 截图与回执）
reviews/*.visual-check.*

# 环境变量与密钥
.env
.env.*
!.env.example

.DS_Store
