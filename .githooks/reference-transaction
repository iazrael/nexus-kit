#!/bin/sh
# 发版锁硬闸（@nexus-kit/devflow）：nexus-devflow release 链中或 release --lock 之后冻结主干，
# 发版执行人凭 NEXUS_RELEASE_TOKEN 放行。确认是残留锁可 nexus-devflow release --unlock。
[ "$1" = "prepared" ] || exit 0
common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
lock="$common_dir/nexus-release.lock"
[ -f "$lock" ] || exit 0
# 锁是 JSON.stringify 缩进输出，一个字段一行：取 "名": 值 的值（去掉引号与行尾逗号）
field() { sed -n 's/^[[:space:]]*"'"$1"'"[[:space:]]*:[[:space:]]*"\{0,1\}\([^",]*\)"\{0,1\},\{0,1\}[[:space:]]*$/\1/p' "$lock" | head -n 1; }
expires=$(field expires)
locked_ref=$(field ref)
case "$expires" in ''|*[!0-9]*) exit 0 ;; esac
[ -n "$locked_ref" ] || exit 0
[ "$(date +%s)" -lt "$expires" ] || exit 0
hit=0
while read -r _old _new ref; do
  [ "$ref" = "$locked_ref" ] && hit=1
done
[ "$hit" = 1 ] || exit 0
token=$(field token)
if [ -n "$token" ] && [ "$NEXUS_RELEASE_TOKEN" = "$token" ]; then
  exit 0
fi
version=$(field version)
[ "$version" = pending ] && version="（版本待定）" || version="v$version"
echo "发版锁生效中：$version 正在发布，$locked_ref 已冻结（约 $(( (expires - $(date +%s)) / 60 )) 分钟后自动失效）。发版执行人凭 NEXUS_RELEASE_TOKEN 放行，其余等发版完成再合入；确认是残留锁可 nexus-devflow release --unlock" >&2
exit 1
