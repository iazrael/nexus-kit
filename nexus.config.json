{
  "appRoot": ".",
  "changelog": {
    "path": "CHANGELOG.md",
    "sourceDirs": ["packages/", "templates/webapp/src/"]
  },
  "docs": {
    "root": "docs",
    "archiveDir": "docs/存档",
    "designDir": "docs/设计",
    "index": "CLAUDE.md"
  },
  "worktree": {
    "share": [],
    "postCreate": [["pnpm", "install", "--frozen-lockfile"]],
    "postMerge": [
      ["pnpm", "install", "--frozen-lockfile"],
      ["pnpm", "check"]
    ],
    "disposable": [".e2e", "templates/webapp/dist", "templates/webapp/.build-number"]
  },
  "release": {
    "steps": [
      ["pnpm", "check"],
      ["pnpm", "e2e"]
    ],
    "push": true,
    "githubRelease": true
  }
}
