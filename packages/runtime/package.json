{
  "name": "@nexus-kit/runtime",
  "version": "0.8.0",
  "description": "运行时基础设施：日志（分区环形缓冲、跨会话持久化、行式导出）、性能采集（水位长线、启动画像、帧统计）、图像资源（加载调度、关键闸门、解码位图缓存）、音频（引擎生命周期与自愈、音效与音乐播放）、生命周期取证与诊断导出、白屏与主包加载失败兜底",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./log": {
      "types": "./dist/log/index.d.ts",
      "default": "./dist/log/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "default": "./dist/lifecycle/index.js"
    },
    "./boot": {
      "types": "./dist/boot/index.d.ts",
      "default": "./dist/boot/index.js"
    },
    "./perf": {
      "types": "./dist/perf/index.d.ts",
      "default": "./dist/perf/index.js"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "default": "./dist/assets/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "default": "./dist/audio/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^18.0.1"
  }
}
