{
  "name": "@nexus-kit/devflow",
  "version": "0.4.0",
  "description": "工程流程：活文档审计、CHANGELOG 提交门禁、git hooks、部署到自有服务器（冒烟 + 自动回滚）、并行开发工作树、发版与发版锁",
  "type": "module",
  "bin": {
    "nexus-devflow": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nexus-kit/vite": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@nexus-kit/vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nexus-kit/vite": "workspace:*"
  }
}
