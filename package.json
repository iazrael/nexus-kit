{
  "name": "nexus-kit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "NODE_ENV=test vitest run",
    "test:coverage": "NODE_ENV=test vitest run --coverage && pnpm test:task",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "docs:check": "node packages/devflow/src/cli.ts docs-audit",
    "worktree:new": "node packages/devflow/src/cli.ts worktree new",
    "worktree:merge": "node packages/devflow/src/cli.ts worktree merge",
    "worktree:rm": "node packages/devflow/src/cli.ts worktree rm",
    "worktree:ls": "node packages/devflow/src/cli.ts worktree ls",
    "worktree:isolate": "node packages/devflow/src/cli.ts worktree isolate",
    "dist:check": "node scripts/check-dist-fresh.ts",
    "check": "pnpm docs:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:task && pnpm dist:check && node scripts/check-boot-es5.ts && pnpm -F nexus-webapp-template test && pnpm -F nexus-webapp-template build",
    "e2e": "node scripts/e2e-upgrade.ts && node scripts/e2e-diagnostics.ts && node scripts/e2e-assets.ts && node scripts/e2e-audio.ts",
    "init-app": "node scripts/init-app.ts",
    "test:task": "pnpm -F @nexus-kit/devflow build && c8 --include='packages/devflow/dist/task/**/*.js' --report-dir=coverage/task --reporter=text --reporter=json-summary --check-coverage --lines=80 --statements=80 --functions=80 --branches=80 node --test scripts/task-integration.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "espree": "11.2.0",
    "globals": "^17.12.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.0"
  }
}
