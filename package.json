{
  "name": "nexus-kit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "NODE_ENV=test vitest run",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "docs:check": "node packages/devflow/src/cli.ts docs-audit",
    "dist:check": "node scripts/check-dist-fresh.ts",
    "check": "pnpm docs:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm dist:check && pnpm -F nexus-webapp-template test && pnpm -F nexus-webapp-template build",
    "e2e": "node scripts/e2e-upgrade.ts && node scripts/e2e-diagnostics.ts",
    "init-app": "node scripts/init-app.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.0"
  }
}
